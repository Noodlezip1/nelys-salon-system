# Nely's Salon Management System - Environment Configuration
APP_NAME="Nely's Salon"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/nelys-salon
TIMEZONE=Asia/Manila

# Database Configuration (XAMPP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nelys_salon_db
DB_USERNAME=root
DB_PASSWORD=

# Security & Authentication
JWT_SECRET=nelys_salon_super_secret_jwt_key_2026_change_in_production
SESSION_LIFETIME=86400

# Two-Factor Authentication (OTP)
OTP_ENABLED=true
OTP_EXPIRY_SECONDS=300

# Gmail SMTP Configuration (For Email OTPs)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="Nely's Salon"

# SMS Gateway Configuration (semaphore | twilio | dev)
SMS_GATEWAY_PROVIDER=dev
SMS_API_KEY=
SMS_SENDER_NAME="NELYSALON"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
